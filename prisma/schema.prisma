generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  title       String
  price       Int
  description String?
  images      String[]
  sizes       String[]
  color       String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id            String    @id @default(cuid())
  customerInfo  Json
  items         Json
  totalPrice    Int
  status        String    @default("pending")
  trackingCode  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
